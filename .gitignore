# Built artifacts under lib/ (rebuild with ./build-lib.sh).
# Source packages (DanTermProtocol, DanTermCore, DanTermSupport, TerminalCore) ARE
# tracked -- only the build artifacts (GhosttyKit.xcframework, ghostty-themes) are ignored.
lib/*
!lib/DanTermProtocol/
!lib/DanTermCore/
!lib/DanTermSupport/
!lib/TerminalCore/
!lib/TerminalPTY/

# Ghostty source cache
.ghostty-src/

# Dev build output
build/
.build/
/result

# SwiftPM
.spm-build/
.swiftpm/
Package.resolved
/scripts/__pycache__
/scripts/tests/__pycache__

# Reproducible external source checkouts (materialize with `just fetch-references`).
/references/
