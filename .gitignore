# Built artifacts under lib/ (rebuild with ./build-lib.sh).
# Source packages (DanTermProtocol, DanTermCore) ARE tracked -- only the build
# artifacts (GhosttyKit.xcframework, ghostty-themes) are ignored.
lib/*
!lib/DanTermProtocol/
!lib/DanTermCore/

# Ghostty source cache
.ghostty-src/

# Dev build output
build/
.build/
/result

# SwiftPM
.spm-build/
.swiftpm/
Package.resolved
