  "initial": { "columns": 4, "rows": 2 },
  "events": [
    { "type": "feed", "text": "ABCDE" },
    { "type": "feed", "base64": "DQo=" },
    {
      "type": "expect",
      "expect": {
        "viewportText": "E   \n    ",
        "softWraps": [false, false],
        "cursor": { "row": 1, "column": 0, "pendingWrap": false },
        "scrollbackCount": 1,
        "scrollbackRows": [
          {
            "softWrapped": true,
            "cells": [
              {
                "kind": "narrow",
                "scalars": "A",
                "style": { "foreground": "default", "background": "default", "attributes": [], "underline": "none" }
              },
              { "kind": "narrow", "scalars": "B" },
              { "kind": "narrow", "scalars": "C" },
              { "kind": "narrow", "scalars": "D" }
            ]
          }
        ],
        "fullHistoryText": "ABCDE"
      }
    },
    { "type": "feed", "base64": "Cg==" },
    {
      "type": "expect",
      "expect": {
        "viewportText": "    \n    ",
        "softWraps": [false, false],
        "cursor": { "row": 1, "column": 0, "pendingWrap": false },
        "scrollbackCount": 2,
        "scrollbackRows": [
          {
            "softWrapped": true,
            "cells": [
              {
                "kind": "narrow",
                "scalars": "A",
                "style": { "foreground": "default", "background": "default", "attributes": [], "underline": "none" }
              },
              { "kind": "narrow", "scalars": "B" },
              { "kind": "narrow", "scalars": "C" },
              { "kind": "narrow", "scalars": "D" }
            ]
          },
          {
            "softWrapped": false,
            "cells": [
              { "kind": "narrow", "scalars": "E" },
              { "kind": "padding", "scalars": "" },
              { "kind": "padding", "scalars": "" },
              { "kind": "padding", "scalars": "" }
            ]
          }
        ],
        "fullHistoryText": "ABCDE"
      }
    }
  ]
