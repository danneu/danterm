{
  "version": 1,
  "provenance": {
    "source": "libvterm",
    "url": "https://github.com/neovim/libvterm/blob/934bc2fbf21800ac3458a499df8820ca5fb45fd3/t/69screen_reflow.test",
    "pinnedCommit": "934bc2fbf21800ac3458a499df8820ca5fb45fd3",
    "upstreamCase": "Resize narrower can create continuation lines",
    "license": "MIT",
    "licenseNotice": "LICENSE.libvterm.txt",
    "recordedDeviations": [
      "DanTerm inserts a spacer head rather than splitting a wide cell at the odd-width boundary.",
      "DanTerm preserves the two trailing blank rows, so narrowing displaces the first two refolded rows into scrollback."
    ]
  },
  "initial": { "columns": 6, "rows": 3 },
  "events": [
    { "type": "feed", "text": "ab\u754ccd" },
    { "type": "resize", "columns": 3, "rows": 3 },
    {
      "type": "expect",
      "expect": {
        "viewportText": "d  \n   \n   ",
        "cellKinds": [
          ["narrow", "padding", "padding"],
          ["padding", "padding", "padding"],
          ["padding", "padding", "padding"]
        ],
        "softWraps": [false, false, false],
        "cursor": { "row": 0, "column": 1, "pendingWrap": false },
        "scrollbackCount": 2,
        "scrollbackRows": [
          {
            "softWrapped": true,
            "cells": [
              { "kind": "narrow", "scalars": "a" },
              { "kind": "narrow", "scalars": "b" },
              { "kind": "spacer-head", "scalars": "" }
            ]
          },
          {
            "softWrapped": true,
            "cells": [
              { "kind": "wide-head", "scalars": "\u754c" },
              { "kind": "wide-tail", "scalars": "" },
              { "kind": "narrow", "scalars": "c" }
            ]
          }
        ],
        "fullHistoryText": "ab\u754ccd"
      }
    }
  ]
}
