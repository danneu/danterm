  "initial": { "columns": 4, "rows": 3 },
  "events": [
    { "type": "feed", "text": "a\r\nb\r\nc\r\nd" },
    {
      "type": "expect",
      "expect": {
        "viewportText": "b   \nc   \nd   ",
        "cursor": { "row": 2, "column": 1, "pendingWrap": false },
        "scrollbackCount": 1
      }
    },
    { "type": "feed", "text": "\u001b[H\u001b[M" },
    {
      "type": "expect",
      "expect": {
        "viewportText": "c   \nd   \n    ",
        "cursor": { "row": 0, "column": 0, "pendingWrap": false },
        "scrollbackCount": 1
      }
    }
  ]
