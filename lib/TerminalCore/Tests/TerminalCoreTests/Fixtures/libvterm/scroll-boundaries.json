  "initial": { "columns": 5, "rows": 4 },
  "events": [
    { "type": "feed", "text": "\u001b[4;5H\u001b[r" },
    {
      "type": "expect",
      "expect": {
        "cursor": { "row": 0, "column": 0, "pendingWrap": false },
        "scrollbackCount": 0
      }
    },
    { "type": "feed", "text": "\u001b[100;105r\u001bD" },
    {
      "type": "expect",
      "expect": {
        "cursor": { "row": 1, "column": 0, "pendingWrap": false },
        "scrollbackCount": 0
      }
    },
    { "type": "feed", "text": "\u001b[5;2r\u001bD" },
    {
      "type": "expect",
      "expect": {
        "cursor": { "row": 1, "column": 0, "pendingWrap": false },
        "scrollbackCount": 0
      }
    }
  ]
}
