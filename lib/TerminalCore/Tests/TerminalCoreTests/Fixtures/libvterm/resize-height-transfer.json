{
  "version": 1,
  "provenance": {
    "source": "libvterm",
    "url": "https://github.com/neovim/libvterm/blob/934bc2fbf21800ac3458a499df8820ca5fb45fd3/t/63screen_resize.test",
    "pinnedCommit": "934bc2fbf21800ac3458a499df8820ca5fb45fd3",
    "upstreamCase": "Resize taller attempts to pop scrollback",
    "license": "MIT",
    "licenseNotice": "LICENSE.libvterm.txt",
    "recordedDeviations": [
      "DanTerm pulls retained rows only while the cursor is on the bottom viewport row."
    ]
  },
  "initial": { "columns": 4, "rows": 2 },
  "events": [
    { "type": "feed", "text": "a\r\nb\r\nc\r\nd" },
    {
      "type": "expect",
      "expect": {
        "viewportText": "c   \nd   ",
        "cursor": { "row": 1, "column": 1, "pendingWrap": false },
        "scrollbackCount": 2,
        "fullHistoryText": "a\nb\nc\nd"
      }
    },
    { "type": "resize", "columns": 4, "rows": 4 },
    {
      "type": "expect",
      "expect": {
        "viewportText": "a   \nb   \nc   \nd   ",
        "cursor": { "row": 3, "column": 1, "pendingWrap": false },
        "scrollbackCount": 0,
        "fullHistoryText": "a\nb\nc\nd"
      }
    },
    { "type": "resize", "columns": 4, "rows": 2 },
    {
      "type": "expect",
      "expect": {
        "viewportText": "c   \nd   ",
        "cursor": { "row": 1, "column": 1, "pendingWrap": false },
        "scrollbackCount": 2,
        "fullHistoryText": "a\nb\nc\nd"
      }
    }
  ]
}
